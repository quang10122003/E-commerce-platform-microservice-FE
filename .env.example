# URL nội bộ của backend, chỉ sử dụng ở phía server.
BACKEND_API_URL=http://localhost:8080

# URL Gateway mà trình duyệt truy cập được, dùng để chuyển sang đăng nhập Google; mặc định dùng BACKEND_API_URL.
BACKEND_PUBLIC_URL=

# Tên cookie httpOnly lưu access token.
ACCESS_TOKEN_COOKIE_NAME=access_token

# Tên cookie httpOnly lưu refresh token.
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# Cookie quyền có chữ ký; secret riêng phía server, tối thiểu 32 ký tự, dùng chung giữa các instance.
ROLE_COOKIE_NAME=role

AUTH_ROLE_COOKIE_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Cookie đăng nhập mặc định có cờ Secure; đặt false khi mở FE qua HTTP bằng địa chỉ khác localhost (IP LAN, tên máy), vì trình duyệt bỏ cookie Secure trên HTTP.
AUTH_COOKIE_SECURE=true

# URL WebSocket công khai của Gateway; không chứa token hay ticket.
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:8080/ws-notifications
